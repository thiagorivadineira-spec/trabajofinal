@page "/agenda"
@attribute [Authorize(Roles = "Veterinario")]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Agenda del día</PageTitle>

<div class="page-header"><div class="page-icon"><i class="bi bi-calendar-day"></i></div><div><h1>Agenda del día</h1><p>Tus turnos asignados</p></div></div>

@if (_error != null) { <div class="alert alert-danger">@_error</div> }

<div class="d-flex gap-2 align-items-center mb-3">
    <button class="btn btn-outline-secondary" @onclick="() => Mover(-1)"><i class="bi bi-chevron-left"></i></button>
    <input type="date" class="form-control" style="max-width:200px" @bind="_dia" @bind:after="Cargar" />
    <button class="btn btn-outline-secondary" @onclick="() => Mover(1)"><i class="bi bi-chevron-right"></i></button>
    <button class="btn btn-outline-primary" @onclick="() => Ir(DateTime.Today)">Hoy</button>
    <button class="btn btn-primary ms-auto" @onclick="@(() => Nav.NavigateTo("mascotas"))"><i class="bi bi-plus-lg"></i> Atención sin turno</button>
</div>

@if (_cargando)
{
    <p class="text-muted">Cargando...</p>
}
else if (_turnos.Count == 0)
{
    <div class="empty-state py-4"><i class="bi bi-cup-hot"></i><p>No tenés turnos para el @(_dia.ToString("dd/MM/yyyy")).</p></div>
}
else
{
    <div class="row g-3">
        @foreach (var t in _turnos)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="fs-4 fw-bold">@t.FechaHora.ToString("HH:mm")</span>
                            <span class="badge estado-@t.Estado">@t.Estado</span>
                        </div>
                        <h2 class="h5 mb-0">@(t.Especie == "Gato" ? "🐱" : "🐶") @t.MascotaNombre</h2>
                        <p class="small text-muted mb-2">@t.DuenoNombre · @t.DuenoTelefono</p>
                        <p class="small mb-3"><strong>Motivo:</strong> @(t.Motivo ?? "-")</p>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="@(() => Nav.NavigateTo($"ficha/{t.MascotaId}"))"><i class="bi bi-file-medical"></i> Ficha clínica</button>
                            @if (t.Estado == "Pendiente")
                            {
                                <button class="btn btn-sm btn-primary" @onclick="@(() => Nav.NavigateTo($"atencion/{t.MascotaId}?turnoId={t.Id}"))"><i class="bi bi-clipboard2-pulse"></i> Atender</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Turno> _turnos = new();
    private DateTime _dia = DateTime.Today;
    private bool _cargando;
    private string? _error;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        _cargando = true;
        _error = null;
        var r = await Api.GetAgendaAsync(_dia);
        _cargando = false;

        if (r.Ok && r.Datos != null) _turnos = r.Datos; else _error = r.Error;
    }

    private Task Mover(int dias) => Ir(_dia.AddDays(dias));

    private Task Ir(DateTime dia)
    {
        _dia = dia;
        return Cargar();
    }
}

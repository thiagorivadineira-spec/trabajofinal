@page "/login"
@inject ApiClient Api
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <span class="brand-icon"><i class="bi bi-heart-pulse"></i></span>
        <h1>Veterinaria Volki</h1>
        <p>Sistema integral de gestión veterinaria</p>
    </div>

    <div class="login-body">
        <h2 class="h5 mb-1">Iniciar sesión</h2>
        <p class="text-muted small mb-3">Acceso para administración, veterinarios y recepción</p>

        @if (_error != null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        <EditForm Model="_modelo" OnSubmit="Ingresar">
            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <InputText class="form-control" @bind-Value="_modelo.Username" autocomplete="username" />
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <InputText type="password" class="form-control" @bind-Value="_modelo.Password" autocomplete="current-password" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2" disabled="@_cargando">
                @(_cargando ? "Ingresando..." : "Ingresar")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginRequest _modelo = new();
    private string? _error;
    private bool _cargando;

    protected override async Task OnInitializedAsync()
    {
        // Si ya hay una sesión activa no tiene sentido mostrar el login
        var estado = await Auth.GetAuthenticationStateAsync();

        if (estado.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("", replace: true);
        }
    }

    private async Task Ingresar()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_modelo.Username) || string.IsNullOrWhiteSpace(_modelo.Password))
        {
            _error = "Ingresá usuario y contraseña.";
            return;
        }

        _cargando = true;
        var resultado = await Api.LoginAsync(_modelo.Username.Trim(), _modelo.Password);
        _cargando = false;

        if (!resultado.Ok || resultado.Datos == null)
        {
            _error = resultado.Error ?? "No se pudo iniciar sesión.";
            return;
        }

        var datos = resultado.Datos;

        // La web es solo para el personal. Los dueños usan la app móvil.
        if (datos.Rol != "Admin" && datos.Rol != "Veterinario" && datos.Rol != "Recepcionista")
        {
            _error = "Esta web es para el personal de la veterinaria. Si sos dueño de una mascota, ingresá desde la app móvil.";
            return;
        }

        await Auth.IniciarSesionAsync(new SesionUsuario
        {
            Token = datos.Token,
            Expira = datos.Expira,
            Id = datos.Id,
            Nombre = datos.Nombre,
            Username = datos.Username,
            Rol = datos.Rol,
            VeterinarioId = datos.VeterinarioId
        });

        // Cada rol arranca en su pantalla principal
        Nav.NavigateTo(datos.Rol == "Veterinario" ? "agenda" : "");
    }
}

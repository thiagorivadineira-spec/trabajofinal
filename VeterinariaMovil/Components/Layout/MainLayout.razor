@inherits LayoutComponentBase
@implements IDisposable
@inject SesionMovil Sesion

@if (!_listo)
{
    <div class="pantalla-centro"><div class="spinner-border text-light"></div></div>
}
else if (Sesion.Actual == null)
{
    @* Sin sesión: solo se ve el login *@
    <Login />
}
else
{
    <header class="app-header">
        <span class="logo"><i class="bi bi-heart-pulse"></i></span>
        <div>
            <div class="app-titulo">Veterinaria Volki</div>
            <div class="app-sub">Hola, @Sesion.Actual.Nombre</div>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <nav class="tabbar">
        <NavLink href="" Match="NavLinkMatch.All"><i class="bi bi-house-heart"></i><span>Inicio</span></NavLink>
        <NavLink href="historial"><i class="bi bi-file-medical"></i><span>Historial</span></NavLink>
        <NavLink href="turnos"><i class="bi bi-calendar-check"></i><span>Turnos</span></NavLink>
        <NavLink href="medicamentos"><i class="bi bi-capsule"></i><span>Remedios</span></NavLink>
        <NavLink href="perfil"><i class="bi bi-person-circle"></i><span>Perfil</span></NavLink>
    </nav>
}

@code {
    private bool _listo;

    protected override async Task OnInitializedAsync()
    {
        Sesion.Cambio += Refrescar;
        await Sesion.CargarAsync();
        _listo = true;
    }

    private void Refrescar() => InvokeAsync(StateHasChanged);

    public void Dispose() => Sesion.Cambio -= Refrescar;
}
